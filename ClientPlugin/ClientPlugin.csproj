<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
        <LangVersion>latestmajor</LangVersion>

        <!-- Ensure SDK generates assembly attributes (no need for AssemblyInfo) -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

        <!-- Default versions; overridden by Version.Build.props -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>

        <PathSeparator Condition="$([MSBuild]::IsOSPlatform('Windows'))">\</PathSeparator>
        <PathSeparator Condition="!$([MSBuild]::IsOSPlatform('Windows'))">/</PathSeparator>
    </PropertyGroup>

    <!-- Auto-detect Game2 by platform when not explicitly set in Directory.Build.props[.user] -->
    <PropertyGroup>
        <!-- Windows: Steam App registry key -->
        <_SteamAppInstallLocation Condition=" '$(Game2)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) ">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 1133870@InstallLocation)</_SteamAppInstallLocation>
        <Game2 Condition=" '$(Game2)' == '' AND '$(_SteamAppInstallLocation)' != '' ">$(_SteamAppInstallLocation)\Game2</Game2>

        <!-- Windows: standard Steam install path -->
        <Game2 Condition=" '$(Game2)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) AND Exists('C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers2\Game2') ">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers2\Game2</Game2>

        <!-- Linux: common Steam install locations under the user home -->
        <_UserHome Condition=" !$([MSBuild]::IsOSPlatform('Windows')) ">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))</_UserHome>
        <Game2 Condition=" '$(Game2)' == '' AND '$(_UserHome)' != '' AND Exists('$(_UserHome)/.steam/steam/steamapps/common/SpaceEngineers2/Game2') ">$(_UserHome)/.steam/steam/steamapps/common/SpaceEngineers2/Game2</Game2>
        <Game2 Condition=" '$(Game2)' == '' AND '$(_UserHome)' != '' AND Exists('$(_UserHome)/.local/share/Steam/steamapps/common/SpaceEngineers2/Game2') ">$(_UserHome)/.local/share/Steam/steamapps/common/SpaceEngineers2/Game2</Game2>
        <Game2 Condition=" '$(Game2)' == '' AND '$(_UserHome)' != '' AND Exists('$(_UserHome)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/SpaceEngineers2/Game2') ">$(_UserHome)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/SpaceEngineers2/Game2</Game2>

        <!-- Game2 with a trailing platform-specific separator, so the reference hint paths stay readable -->
        <Game2Dir>$(Game2)</Game2Dir>
        <Game2Dir Condition=" '$(Game2Dir)' != '' AND !HasTrailingSlash('$(Game2Dir)') ">$(Game2Dir)$(PathSeparator)</Game2Dir>
    </PropertyGroup>

    <!-- Auto-detect Pulsar's data folder when not explicitly set in Directory.Build.props[.user] -->
    <PropertyGroup>
        <Pulsar Condition=" '$(Pulsar)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) ">$(APPDATA)\Pulsar</Pulsar>
        <Pulsar Condition=" '$(Pulsar)' == '' AND '$(_UserHome)' != '' ">$(_UserHome)/.config/Pulsar</Pulsar>

        <!-- Local plugin DLL deployment folder -->
        <LocalDeploymentDir Condition=" '$(LocalDeploymentDir)' == '' ">$(Pulsar)$(PathSeparator)Modern$(PathSeparator)Local</LocalDeploymentDir>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>x64</PlatformTarget>
      <DefineConstants>TRACE;DEV_BUILD</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>x64</PlatformTarget>
      <DefineConstants>TRACE;DEV_BUILD</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>ClientPluginTemplate</AssemblyName>
    </PropertyGroup>

    <Target Name="VerifyProps" BeforeTargets="BeforeBuild">
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="call &quot;$(RepoRoot)verify_props.bat&quot; &quot;$(Game2)&quot;" />
        <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
              Command="sh &quot;$(RepoRoot)verify_props.sh&quot; &quot;$(Game2)&quot;" />
    </Target>

    <Target Name="DeployPlugin" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalDeploymentDir)" Retries="0" />
    </Target>
    
    <ItemGroup>
      <PackageReference Include="Lib.Harmony" Version="2.4.2" />
      <PackageReference Include="Mono.Cecil" Version="0.11.6" />
      <!-- Uncomment to enable publicizer support
      <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      -->
    </ItemGroup>

    <!-- Uncomment to enable publicizer support
    <PropertyGroup>
      <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
      <PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
      <PublicizerLogFilePath>$(MSBuildProjectDirectory)$(PathSeparator)$(OutputPath)Krafs.Publicizer.log</PublicizerLogFilePath>
    </PropertyGroup>
    
    <ItemGroup>
      <Publicize Include="Game2.Game"/>
      <Publicize Include="Game2.Client"/>
    </ItemGroup>
    -->

